{
  "name": "agentic-tracking",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "infra:up": "docker compose --project-directory . -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --project-directory . -f infra/docker-compose.yml down",
    "dev": "pnpm infra:up && turbo run dev",
    "lint": "turbo run lint lint:root",
    "lint:root": "biome check package.json turbo.json biome.json tsconfig.base.json pnpm-workspace.yaml scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "agent:metrics": "node scripts/agent-metrics.mjs",
    "adr:index": "node scripts/adr-index.mjs",
    "findings:index": "node scripts/findings-index.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24",
    "turbo": "^2",
    "typescript": "^5",
    "vitest": "^3"
  }
}
