{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Milestone audit report",
  "type": "object",
  "required": ["milestone", "generated_at", "auditor", "findings"],
  "additionalProperties": false,
  "properties": {
    "milestone": { "type": "string", "pattern": "^M[0-9]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "auditor": { "type": "string" },
    "findings": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "category", "evidence", "rationale", "proposal", "effort"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]{2}$" },
          "title": { "type": "string", "maxLength": 100 },
          "severity": { "enum": ["high", "medium", "low"] },
          "category": {
            "enum": ["invariant", "adr", "tests", "correctness", "security", "agent-workflow", "maintainability"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "note": { "type": "string" }
              }
            }
          },
          "rationale": { "type": "string" },
          "proposal": { "type": "string" },
          "effort": { "enum": ["S", "M", "L"] }
        }
      }
    }
  }
}
